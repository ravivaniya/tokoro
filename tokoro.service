[Unit]
Description=tokoro HTTP server
After=network.target

[Service]
Type=simple
User=tokoro
Group=tokoro
ExecStart=/usr/local/bin/tokoro --port 8080 --docroot /var/www/tokoro
Restart=on-failure
RestartSec=5
LimitNOFILE=65536
MemoryMax=512M
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
